{
  "name": "air-defense-sim",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive, educational air-defense simulator: drag a drone, missile or jet onto the map and watch a generic defense battery detect, track, identify, evaluate, engage and assess it.",
  "keywords": [
    "simulation",
    "education",
    "physics",
    "radar",
    "kalman-filter",
    "proportional-navigation",
    "threejs",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "author": "MohammadAlyounes",
  "homepage": "https://mohammadalyounes.github.io/air-defense-sim/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MohammadAlyounes/air-defense-sim.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "media:screenshots": "node scripts/media/screenshots.mjs",
    "media:previews": "node scripts/media/previews.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
